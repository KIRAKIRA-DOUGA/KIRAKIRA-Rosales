{
	"name": "kirakira-rosales",
	"version": "1.0.0",
	"description": "KIRAKIRA-Rosales, The RESTful Back-end API Created by koa.",
	"main": "src/app.ts",
	"type": "module",
	"author": "KIRAKIRA Project Team",
	"private": true,
	"scripts": {
		"start": "rimraf .kirakira && tsc --noEmitOnError --sourceMap --outDir .kirakira && npm run copy-assets-dev && node ./.kirakira/app.js",
		"dev": "npm start",
		"serve": "npm start",
		"dev-hot": "nodemon --watch src --delay 2 -e ts --exec \"npm start\"",
		"build": "rimraf .kirakira && tsc --removeComments --declaration --outDir dist && npm run copy-assets-build",
		"copy-assets-dev": "cpy \"src/assets/**/*\" .kirakira/assets/",
		"copy-assets-build": "cpy \"src/assets/**/*\" dist/assets/"
	},
	"devDependencies": {
		"@eslint/js": "^9.31.0",
		"@types/bcrypt": "^6.0.0",
		"@types/koa": "^3.0.1",
		"@types/koa__router": "^12.0.4",
		"@types/koa-bodyparser": "^4.3.10",
		"@types/safe-regex": "^1.1.6",
		"@typescript-eslint/eslint-plugin": "^8.38.0",
		"@typescript-eslint/parser": "^8.38.0",
		"cpy-cli": "^6.0.0",
		"esbuild-register": "^3.4.1",
		"eslint": "^9.9.0",
		"nodemon": "^3.1.4",
		"rimraf": "^6.1.2",
		"typescript": "^5.5.4"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.966.0",
		"@aws-sdk/client-secrets-manager": "^3.966.0",
		"@aws-sdk/s3-request-presigner": "^3.966.0",
		"@elastic/elasticsearch": "^8.19.1",
		"@koa/cors": "^5.0.0",
		"@koa/router": "^15.2.0",
		"bcrypt": "^6.0.0",
		"dotenv": "^17.2.1",
		"emailjs": "^5.0.0",
		"js-base64": "^3.7.5",
		"koa": "^3.0.1",
		"koa-bodyparser": "^4.4.0",
		"mongoose": "^9.1.2",
		"otplib": "^12.0.1",
		"safe-regex": "^2.1.1",
		"uuid": "^13.0.0"
	}
}
